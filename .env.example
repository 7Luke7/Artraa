# Template for Artra's environment. Copy to .env and fill in.
#   cp .env.example .env
#
# .env is gitignored. Never commit a filled-in copy.

# --- Public URLs -------------------------------------------------------------
# VITE_* values are inlined into the client bundle at build time, so a change
# here needs a rebuild, not just a restart.
VITE_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_EMAIL=support@example.com
VITE_GOOGLE_CLIENT_ID=

# --- Data --------------------------------------------------------------------
DATABASE_URL=postgres://artra:<password>@127.0.0.1:5432/courses

# Either a single URL...
# REDIS_URL=redis://127.0.0.1:6379
# ...or the host/port/password triple. Leave REDIS_PASSWORD empty for a Redis
# with no ACLs configured; AUTH is only sent when a password is present.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Cryptographic keys ------------------------------------------------------
# Any random value works, but they must stay stable: rotating ARGON_SECRET
# invalidates every stored password hash.
ARGON_SECRET=
CODE_PEPPER=
PASSWORD_RESET_SECRET=
SIGNATURE_SECRET=
IP_SECRET=

# --- Email -------------------------------------------------------------------
# resend (production) or smtp (local development and the E2E stack).
# See ../artra-e2e/docs/EMAIL.md for the Resend sender-domain requirement.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Artra <no-reply@your-verified-domain>
EMAIL_REPLY_TO=support@example.com

# Only used when EMAIL_PROVIDER=smtp.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Payments and media (not needed to run the E2E suite) --------------------
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
CF_ACCOUNT_ID=
CF_ACCOUNT_HASH=
CF_IMAGES_TOKEN=
CF_STREAM_ACCOUNT_ID=
CF_STREAM_KEY_ID=
CF_STREAM_PRIVATE_KEY=
GOOGLE_CLIENT_SECRET=
